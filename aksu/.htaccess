# IUO e-Library: rules for Apache / LiteSpeed (cPanel hosting, e.g. WhoGoHost)
Options -MultiViews -Indexes
RewriteEngine On

# 1) Always use https (sign-in needs it). Requires the free SSL certificate
#    to be active first: cPanel > SSL/TLS Status > Run AutoSSL.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Single-page app: send every page address (e.g. /login) to index.html
#    unless it is a real file or folder.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 3) Caching: hashed build files can be cached for a year; index.html never.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
